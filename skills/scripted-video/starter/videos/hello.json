{
  "format": "video-script",
  "version": 1,
  "id": "hello",
  "title": { "$t": "title" },
  "stage": { "width": 1920, "height": 1080, "fps": 30, "background": "#0b1626" },
  "defaultLanguage": "en",
  "tail": 1.5,
  "assets": {
    "plant": "assets/example/plant.svg",
    "pop": "assets/example/pop.wav",
    "bed": "assets/example/bed.m4a"
  },
  "strings": {
    "en": {
      "title": "How a plant makes its food",
      "hi": "A plant makes its own food.",
      "needs": "It needs three things: sunlight, water and air.",
      "leaf": "The leaves catch the sunlight.",
      "bye": "That is why plants grow toward the light.",
      "leafLabel": "leaf",
      "chapter": "How a plant eats"
    },
    "es": {
      "title": "Cómo fabrica su alimento una planta",
      "hi": "Una planta fabrica su propio alimento.",
      "needs": "Necesita tres cosas: luz del sol, agua y aire.",
      "leaf": "Las hojas atrapan la luz del sol.",
      "bye": "Por eso las plantas buscan la luz.",
      "leafLabel": "hoja",
      "chapter": "Cómo se alimenta una planta"
    }
  },
  "layouts": {
    "vertical": {
      "width": 1080,
      "height": 1920,
      "clips": {
        "heading": { "box": { "x": 70, "y": 200, "w": 940, "h": 300 } },
        "picture": { "box": { "x": 40, "y": 600, "w": 1000, "h": 640 } }
      }
    }
  },
  "tracks": [
    {
      "id": "base",
      "kind": "visual",
      "clips": [
        {
          "id": "heading",
          "module": "text",
          "start": "@start",
          "box": { "x": 115, "y": 60, "w": 1690, "h": 170 },
          "props": { "text": { "$t": "title" }, "role": "title" },
          "in": "slide-up"
        },
        {
          "id": "picture",
          "module": "image",
          "start": "@needs-0.3",
          "box": { "x": 460, "y": 250, "w": 1000, "h": 640 },
          "props": { "src": "plant", "fit": "contain" },
          "in": { "type": "fade", "duration": 0.6 },
          "keyframes": {
            "scale": [
              { "at": "@needs", "value": 0.92 },
              { "at": "@end", "value": 1, "ease": "out" }
            ]
          }
        }
      ]
    },
    {
      "id": "overlay",
      "kind": "visual",
      "clips": [
        {
          "id": "marks",
          "module": "annotate",
          "start": "@needs",
          "commands": [
            {
              "id": "ringLeaf",
              "at": "@leaf",
              "name": "point",
              "args": { "target": { "clip": "picture", "rect": [0.53, 0.37, 0.26, 0.23] }, "style": "ring", "label": { "$t": "leafLabel" }, "side": "right" }
            },
            { "at": "@leaf.end+0.4", "name": "clear", "duration": 0.25 }
          ]
        }
      ]
    },
    {
      "id": "voice",
      "kind": "narration",
      "segments": [
        { "id": "hi", "text": { "$t": "hi" }, "gap": 1 },
        { "id": "needs", "text": { "$t": "needs" } },
        { "id": "leaf", "text": { "$t": "leaf" }, "gap": 0.8 },
        { "id": "bye", "text": { "$t": "bye" }, "gap": 0.8 }
      ]
    },
    {
      "id": "sound",
      "kind": "audio",
      "clips": [
        { "src": "bed", "start": "@start", "end": "@hi", "volume": 0.5, "fadeOut": 0.6, "duck": true },
        { "src": "pop", "start": "@ringLeaf", "volume": 0.5 }
      ]
    }
  ],
  "markers": [{ "kind": "chapter", "at": "@start", "label": { "$t": "chapter" } }]
}
